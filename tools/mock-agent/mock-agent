#!/usr/bin/env python3
import sys
import threading
import time

VERSION = "mock-agent 1.0.0"
SPINNER = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
lock = threading.Lock()


def out(text):
    with lock:
        sys.stdout.write(text)
        sys.stdout.flush()


def composer():
    out("\r\n› \r\n  ? for shortcuts\x1b[1A\x1b[3G")


def work(seconds):
    out("\x1b]9;4;3\x07")
    start = time.monotonic()
    frame = 0
    while time.monotonic() - start < seconds:
        elapsed = int(time.monotonic() - start)
        out(f"\x1b[?2026h\r\x1b[2K{SPINNER[frame % len(SPINNER)]} Working ({elapsed}s • esc to interrupt)\x1b[?2026l")
        frame += 1
        time.sleep(0.1)
    out("\r\x1b[2K\x1b]9;4;0\x07")


def ask():
    out("\r\nDo you want to proceed?\r\n❯ 1. Yes\r\n  2. No\r\n")


def main():
    if "--version" in sys.argv[1:]:
        print(VERSION)
        return 0
    out("\x1b]0;mock-agent\x07mock-agent: type turn, work N, ask or exit\r\n")
    if sys.argv[1:]:
        out("args: " + " ".join(sys.argv[1:]) + "\r\n")
    composer()
    asking = False
    for line in sys.stdin:
        words = line.split()
        out("\x1b[J\r\n")
        if asking:
            asking = False
            out("\x1b[2J\x1b[H")
            if words[:1] in (["1"], ["y"], ["yes"]):
                work(1)
                out("TURN_DONE\r\n")
            else:
                out("Declined.\r\n")
            composer()
            continue
        if words[:1] == ["exit"]:
            return 0
        if words[:1] == ["work"]:
            work(float(words[1]) if len(words) > 1 else 2)
            out("WORK_DONE\r\n")
        elif words[:1] == ["turn"]:
            work(2)
            ask()
            asking = True
            continue
        elif words[:1] == ["ask"]:
            ask()
            asking = True
            continue
        else:
            out(f"echo: {line.strip()}\r\n")
        composer()
    return 0


if __name__ == "__main__":
    sys.exit(main())
