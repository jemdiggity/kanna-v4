from pathlib import Path

HERE = Path(__file__).resolve().parent
PAGE = HERE / "page.html"
STATE = Path(os.environ.get("KANNA_DOC_PROTOTYPE_DIR", Path.home() / ".kanna-doc-prototype"))
SERVER_FILE = STATE / "server.json"
IMAGES = {".png", ".jpg", ".jpeg", ".gif", ".svg", ".webp"}
PAGES = {".html", ".htm"}
RAW = PAGES | IMAGES | {".css", ".js", ".mjs", ".json", ".woff", ".woff2", ".ttf", ".otf", ".ico"}


def repo_root(path):
    start = path if path.is_dir() else path.parent
    try:
        out = subprocess.run(["git", "-C", str(start), "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True)
        return Path(out.stdout.strip())
    except (subprocess.CalledProcessError, FileNotFoundError):
        return start


def real_folder(path):
    try:
        path.mkdir(mode=0o755)
    except FileExistsError:
        pass
    if path.is_symlink() or not path.is_dir():
        raise SystemExit(f"kanna-doc: {path} is not a plain folder; refusing to write through it")


def store_dir(root):
    d = root / ".kanna" / "docs"
    real_folder(root / ".kanna")
    real_folder(d)
    return d


def read_no_follow(path):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError:
        return None
    with os.fdopen(fd, "rb") as f:
        return f.read()


def write_no_follow(path, data):
    tmp = f"{path}.{secrets.token_hex(8)}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def store_path(file):
    root = repo_root(file)
    rel = os.path.relpath(file, root)
    return store_dir(root) / (rel.replace(os.sep, "__") + ".json")


@contextmanager
def locked(file):
    path = store_path(file)
    lock = os.open(str(path) + ".lock", os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        raw = read_no_follow(path)
        doc = json.loads(raw) if raw else {"file": str(file), "agent": None, "socket": None, "next": 1, "threads": []}
        yield doc
        write_no_follow(path, json.dumps(doc, indent=2, ensure_ascii=False).encode())
    finally:
        fcntl.flock(lock, fcntl.LOCK_UN)
        os.close(lock)


def read_doc(file):
    raw = read_no_follow(store_path(file))
    if not raw:
        return {"file": str(file), "agent": None, "socket": None, "next": 1, "threads": []}
    return with_lines(json.loads(raw))


def now():
    return time.strftime("%Y-%m-%dT%H:%M:%S")


def current_line(src, t):
    words = t["quote"].split()
    for probe in (t["quote"], " ".join(words[:3]), " ".join(words[:1])):
        if not probe:
            continue
        hits = []
        at = src.find(probe)
        while at >= 0:
            hits.append(src.count("\n", 0, at) + 1)
            at = src.find(probe, at + 1)
        if hits:
            return min(hits, key=lambda n: abs(n - t["line"])), False
    return t["line"], True


def image_line(src, t):
    lines = [n for n, text in enumerate(src.splitlines(), 1) if f"]({t['image']})" in text or f"]({t['image']} " in text]
    return (min(lines, key=lambda n: abs(n - t["line"])), False) if lines else (t["line"], True)


def with_lines(doc):
    try:
        src = Path(doc["file"]).read_text(errors="replace")
    except OSError:
        return doc
    for t in doc["threads"]:
        if t.get("page"):
            t["line"], _ = current_line(src, {"quote": t["page"].get("text") or "", "line": t["line"]})
            t["detached"] = False
            continue
        t["line"], t["detached"] = image_line(src, t) if t.get("image") else current_line(src, t)
    return doc


def find_thread(doc, tid):
    for t in doc["threads"]:
        if t["id"] == tid:
            return t
    raise SystemExit(f"kanna-doc: no thread {tid} in {doc['file']}")


def rel_name(file):
    return os.path.relpath(file, repo_root(file))


CONTROL = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f]")


def clean(text):
    return CONTROL.sub("", text.replace("\r\n", "\n").replace("\r", "\n"))


THREAD_ID = re.compile(r"c[0-9]{1,10}")


def describe_region(region):
    if not region:
        return "the whole image"
    x, y, w, h = (round(v * 100) for v in region)
    return f"the box from {x}%,{y}% to {x + w}%,{y + h}% (left,top to right,bottom)"


MARKUP = re.compile(r"[`*_\[\]()<>#|\\]")


def plain(s):
    return " ".join(MARKUP.sub(" ", s).split())


def quote_in_doc(doc, quote):
    try:
        src = Path(doc["file"]).read_text(errors="replace")
    except OSError:
        return False
    return len(quote) <= 2000 and bool(plain(quote)) and plain(quote) in plain(src)


def mark_path(file, tid):
    root = repo_root(file)
    path = root / ".kanna" / "docs" / "marks" / f"{store_path(file).stem}-{tid}.png"
    raw = read_no_follow(path)
    return os.path.relpath(path, root) if raw and raw.startswith(PNG) else None


BREAKS = re.compile(r"[\x00-\x1f\x7f-\x9f\u2028\u2029]")


def one_line(s):
    return BREAKS.sub("?", str(s))


def message(doc, t, text):
    if not THREAD_ID.fullmatch(t["id"]):
        raise SystemExit(f"kanna-doc: refusing to send thread id {t['id']!r}")
    header = f"[kanna comment {t['id']} · {one_line(rel_name(Path(doc['file'])))}:{int(t['line'])}]"
    if t.get("detached"):
        return f"{header}\n{text}"
    if t.get("page"):
        try:
            page = clean_page(t["page"])
        except SystemExit:
            return f"{header}\n{text}"
        lines = [f"> {describe_page(page)}"]
        x, y, w, h = page["box"]
        lines.append(f"> box {x},{y} to {x + w},{y + h} px in a {page['viewport'][0]}×{page['viewport'][1]} view, scrolled to {page['scroll'][0]},{page['scroll'][1]}")
        mark = mark_path(Path(doc["file"]), t["id"])
        if mark:
            lines.append(f"> marked up: {mark}")
        return header + "\n" + "\n".join(lines) + "\n" + text
    if t.get("image"):
        image = str(t["image"])
        if one_line(image) != image or len(image) > 500:
            return f"{header}\n{text}"
        try:
            region = clean_region(t.get("region"))
        except SystemExit:
            return f"{header}\n{text}"
        lines = [f"> image {image}, {describe_region(region)}"]
        mark = mark_path(Path(doc["file"]), t["id"])
        if mark:
            lines.append(f"> marked up: {mark}")
        return header + "\n" + "\n".join(lines) + "\n" + text
    if not quote_in_doc(doc, t["quote"]):
        return f"{header}\n{text}"
    quote = "\n".join("> " + one_line(line) for line in clean(t["quote"]).split("\n")) or "> "
    return f"{header}\n{quote}\n{text}"


def send_to_agent(doc, text):
    if not doc.get("agent"):
        return "no agent"
    env = dict(os.environ)
    if doc.get("socket"):
        env["KANNA_SOCKET"] = doc["socket"]
    paste = "\x1b[200~" + clean(text) + "\x1b[201~"
    r = subprocess.run(["kanna", "send", doc["agent"], "--", paste], env=env, capture_output=True, text=True)
    if r.returncode != 0:
        return (r.stderr or r.stdout).strip() or f"kanna send exited {r.returncode}"
    time.sleep(0.4)
    subprocess.run(["kanna", "send", doc["agent"], "--", ""], env=env, capture_output=True, text=True)
    return None


PNG = b"\x89PNG\r\n\x1a\n"


def clean_region(region):
    if region is None:
        return None
    if not (isinstance(region, list) and len(region) == 4 and all(isinstance(v, (int, float)) for v in region)):
        raise SystemExit("kanna-doc: region is [x, y, width, height] as fractions")
    x, y, w, h = (min(1.0, max(0.0, float(v))) for v in region)
    return [round(x, 4), round(y, 4), round(min(w, 1 - x), 4), round(min(h, 1 - y), 4)]


def save_mark(file, tid, data_url):
    head, _, body = (data_url or "").partition(",")
    if head != "data:image/png;base64":
        return None
    data = base64.b64decode(body, validate=True)
    if not data.startswith(PNG) or len(data) > 8 * 1024 * 1024:
        return None
    root = repo_root(file)
    folder = store_dir(root) / "marks"
    real_folder(folder)
    path = folder / f"{store_path(file).stem}-{tid}.png"
    write_no_follow(path, data)
    return os.path.relpath(path, root)


def clean_page(page):
    if not isinstance(page, dict):
        raise SystemExit("kanna-doc: page is an object")
    def numbers(key, n):
        v = page.get(key)
        if not (isinstance(v, list) and len(v) == n and all(isinstance(x, (int, float)) for x in v)):
            raise SystemExit(f"kanna-doc: page.{key} is {n} numbers")
        return [int(max(0, min(100000, x))) for x in v]
    def short(key, cap):
        v = page.get(key) or ""
        if not isinstance(v, str):
            raise SystemExit(f"kanna-doc: page.{key} is text")
        v = one_line(" ".join(v.split()))
        return v if len(v) <= cap else v[: cap - 1] + "…"
    return {"selector": short("selector", 200), "text": short("text", 120), "hash": short("hash", 100),
            "box": numbers("box", 4), "viewport": numbers("viewport", 2), "scroll": numbers("scroll", 2)}


def describe_page(page):
    where = f"the page at {page['hash']}" if page["hash"] else "the page"
    if page["selector"]:
        return f"{where}, element {page['selector']}" + (f' "{page["text"]}"' if page["text"] else "")
    return f"{where}, a box"


def add_comment(file, quote, text, line, prefix="", suffix="", image=None, region=None, snapshot=None, page=None):
    with locked(file) as doc:
        tid = f"c{doc['next']}"
        doc["next"] += 1
        t = {"id": tid, "quote": quote, "prefix": prefix, "suffix": suffix, "line": line, "state": "open",
             "status": "sent", "messages": [{"who": "you", "text": text, "at": now()}], "error": None}
        if image:
            t["image"] = image
            t["region"] = clean_region(region)
            t["mark"] = save_mark(file, tid, snapshot)
        if page is not None:
            t["page"] = clean_page(page)
            t["mark"] = save_mark(file, tid, snapshot)
        doc["threads"].append(t)
        snapshot = with_lines(json.loads(json.dumps(doc)))
        t = find_thread(snapshot, tid)
    error = send_to_agent(snapshot, message(snapshot, t, text))
    with locked(file) as doc:
        t2 = find_thread(doc, tid)
        t2["status"] = "unsent" if error else "sent"
        t2["error"] = error
    return tid, error


def add_your_reply(file, tid, text):
    with locked(file) as doc:
        t = find_thread(doc, tid)
        t["messages"].append({"who": "you", "text": text, "at": now()})
        t["state"] = "open"
        snapshot = with_lines(json.loads(json.dumps(doc)))
        t = find_thread(snapshot, tid)
    error = send_to_agent(snapshot, message(snapshot, t, text))
    with locked(file) as doc:
        t2 = find_thread(doc, tid)
        t2["status"] = "unsent" if error else "sent"
        t2["error"] = error
    return error


def set_state(file, tid, state):
    with locked(file) as doc:
        find_thread(doc, tid)["state"] = state


def docs_in(root):
    d = root / ".kanna" / "docs"
    if not d.is_dir():
        return []
    out = []
    for p in d.glob("*.json"):
        try:
            raw = None if p.is_symlink() else read_no_follow(p)
            if raw:
                out.append((p.stat().st_mtime, json.loads(raw)))
        except (OSError, json.JSONDecodeError):
            pass
    return [doc for _, doc in sorted(out, key=lambda x: -x[0])]


def resolve_doc(args, tid=None):
    if args.doc:
        return Path(args.doc).resolve()
    docs = docs_in(repo_root(Path.cwd()))
    pane = os.environ.get("KANNA_PANE")
    mine = [d for d in docs if pane and d.get("agent") == pane]
    for group in (mine, docs):
        for d in group:
            if tid is None or any(t["id"] == tid for t in d["threads"]):
                return Path(d["file"])
    raise SystemExit("kanna-doc: no doc found here" + (f" with thread {tid}" if tid else "") + "; pass --doc FILE")


def server_alive():
    try:
        info = json.loads(SERVER_FILE.read_text())
        with urllib.request.urlopen(f"http://127.0.0.1:{info['port']}/ping?token={info['token']}", timeout=1) as r:
            if r.read() == b"pong":
                return info
    except Exception:
        pass
    return None


def ensure_server():
    info = server_alive()
    if info:
        return info
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(STATE, 0o700)
    log = open(STATE / "server.log", "a")
    subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "serve"], stdout=log, stderr=log, stdin=subprocess.DEVNULL, start_new_session=True)
    for _ in range(50):
        time.sleep(0.1)
        info = server_alive()
        if info:
            return info
    raise SystemExit(f"kanna-doc: the server didn't start; see {STATE / 'server.log'}")


class Handler(BaseHTTPRequestHandler):
    token = ""

    def log_message(self, fmt, *a):
        pass

    def reply(self, code, body, ctype="application/json"):
        data = body if isinstance(body, bytes) else (json.dumps(body, ensure_ascii=False) if ctype == "application/json" else body).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype + ("; charset=utf-8" if ctype.startswith(("text", "application/json")) else ""))
        self.send_header("Cache-Control", "no-store")
        if getattr(self, "csp", None):
            self.send_header("Content-Security-Policy", self.csp)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def guard(self, q):
        if not secrets.compare_digest(q.get("token", [""])[0], self.token):
            self.reply(403, {"error": "bad token"})
            return None
        f = q.get("file", [""])[0]
        if not f:
            return Path()
        p = Path(f).resolve()
        if p.suffix.lower() not in {".md"} | PAGES or not p.is_file():
            self.reply(404, {"error": f"not a markdown file or a page: {f}"})
            return None
        if p.suffix.lower() in PAGES:
            PageHandler.roots.add(repo_root(p).resolve())
        return p

    def do_GET(self):
        u = urllib.parse.urlparse(self.path)
        q = urllib.parse.parse_qs(u.query)
        if u.path == "/ping":
            return self.reply(200, b"pong" if secrets.compare_digest(q.get("token", [""])[0], self.token) else b"no", "text/plain")
        p = self.guard(q)
        if p is None:
            return
        if u.path == "/":
            nonce = secrets.token_urlsafe(16)
            self.csp = f"default-src 'self'; frame-src {PageHandler.origin}/; script-src 'nonce-{nonce}' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
            return self.reply(200, PAGE.read_text().replace("__NONCE__", nonce).encode(), "text/html")
        if u.path == "/api/doc":
            doc = read_doc(p)
            return self.reply(200, {"file": str(p), "rel": rel_name(p), "kind": "page" if p.suffix.lower() in PAGES else "doc", "pages": f"{PageHandler.origin}/{PageHandler.token}",
                                    "source": "" if p.suffix.lower() in PAGES else p.read_text(errors="replace"),
                                    "mtime": p.stat().st_mtime, "agent": doc.get("agent"), "threads": doc["threads"]})
        if u.path == "/asset":
            target = (p.parent / q.get("path", [""])[0]).resolve()
            root = repo_root(p).resolve()
            if target.suffix.lower() not in IMAGES or root not in target.parents or not target.is_file():
                return self.reply(404, {"error": "no such image"})
            return self.reply(200, target.read_bytes(), mimetypes.guess_type(str(target))[0] or "application/octet-stream")
        self.reply(404, {"error": "not found"})

    def do_POST(self):
        u = urllib.parse.urlparse(self.path)
        q = urllib.parse.parse_qs(u.query)
        p = self.guard(q)
        if p is None:
            return
        length = int(self.headers.get("Content-Length", "0"))
        if length > 12 * 1024 * 1024:
            return self.reply(413, {"error": "too large"})
        body = json.loads(self.rfile.read(length) or b"{}")
        if u.path == "/api/comment":
            image = clean(body["image"]) if body.get("image") else None
            tid, error = add_comment(p, clean(body["quote"]), clean(body["text"]), int(body.get("line", 1)), body.get("prefix", ""), body.get("suffix", ""),
                                     image, body.get("region"), body.get("snapshot"), body.get("page"))
            return self.reply(200, {"id": tid, "error": error})
        if u.path == "/api/reply":
            return self.reply(200, {"error": add_your_reply(p, body["id"], clean(body["text"]))})
        if u.path in ("/api/resolve", "/api/reopen"):
            set_state(p, body["id"], "resolved" if u.path == "/api/resolve" else "open")
            return self.reply(200, {})
        self.reply(404, {"error": "not found"})


class PageHandler(Handler):
    token = ""
    origin = ""
    parent = ""
    roots = set()
    frame_js = Path(__file__).resolve().parent / "frame.js"
    tools = ('<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js" '
             'integrity="sha384-ZZ1pncU3bQe8y31yfZdMFdSpttDoPmOZg2wguVK9almUodir1PghgT0eY7Mrty8H" crossorigin="anonymous"></script>')

    def do_GET(self):
        self.csp = f"frame-ancestors {PageHandler.parent}"
        token, _, path = urllib.parse.urlparse(self.path).path.lstrip("/").partition("/")
        if not secrets.compare_digest(token, self.token):
            return self.reply(403, {"error": "bad token"})
        if path == "__kanna__/frame.js":
            return self.reply(200, self.frame_js.read_bytes(), "text/javascript")
        target = Path("/" + urllib.parse.unquote(path)).resolve()
        inside = [r for r in PageHandler.roots if r in target.parents]
        hidden = any(part.startswith(".") for part in target.relative_to(inside[0]).parts) if inside else True
        if hidden or target.suffix.lower() not in RAW or not target.is_file():
            return self.reply(404, {"error": "not found"})
        data = target.read_bytes()
        if target.suffix.lower() in PAGES:
            inject = (self.tools + f'<script src="/{self.token}/__kanna__/frame.js" data-parent="{PageHandler.parent}"></script>').encode()
            at = re.search(rb"<head[^>]*>", data, re.I) or re.search(rb"<!doctype[^>]*>", data, re.I)
            data = data[: at.end()] + inject + data[at.end():] if at else inject + data
        return self.reply(200, data, mimetypes.guess_type(str(target))[0] or "application/octet-stream")

    def do_POST(self):
        self.reply(405, {"error": "read only"})


def cmd_serve(args):
    token = secrets.token_hex(12)
    Handler.token = token
    server = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    pages = ThreadingHTTPServer(("127.0.0.1", 0), PageHandler)
    PageHandler.token = secrets.token_hex(12)
    PageHandler.origin = f"http://127.0.0.1:{pages.server_address[1]}"
    PageHandler.parent = f"http://127.0.0.1:{server.server_address[1]}"
    threading.Thread(target=pages.serve_forever, daemon=True).start()
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(STATE, 0o700)
    fd = os.open(SERVER_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(json.dumps({"port": server.server_address[1], "token": token, "pid": os.getpid()}))
    os.chmod(SERVER_FILE, 0o600)
    print(f"kanna-doc: serving on 127.0.0.1:{server.server_address[1]}", flush=True)
    server.serve_forever()


def cmd_open(args):
    file = Path(args.file).resolve()
    if not file.is_file():
        raise SystemExit(f"kanna-doc: no such file: {args.file}")
    with locked(file) as doc:
        doc["agent"] = os.environ.get("KANNA_PANE")
        doc["socket"] = os.environ.get("KANNA_SOCKET")
    info = ensure_server()
    url = f"http://127.0.0.1:{info['port']}/?" + urllib.parse.urlencode({"token": info["token"], "file": str(file)})
    if args.print_url:
        print(url)
        return
    placement = ["--tab"] if args.tab else ["--split", args.split]
    r = subprocess.run(["kanna", "open", "web", url, *placement])
    if r.returncode == 0 and not os.environ.get("KANNA_PANE"):
        print("kanna-doc: not run from a Kanna terminal, so comments won't be sent anywhere", file=sys.stderr)
    sys.exit(r.returncode)


def describe(t):
    return f"{t['id']}  {'detached' if t.get('detached') else 'line ' + str(t['line'])}  {t['state']}{'  (agent replied)' if t['messages'][-1]['who'] == 'agent' else ''}  “{t['quote'][:50]}”"


def cmd_comments(args):
    file = resolve_doc(args)
    doc = read_doc(file)
    shown = [t for t in doc["threads"] if args.all or t["state"] == "open"]
    if args.json:
        return print(json.dumps(shown, indent=2, ensure_ascii=False))
    print(rel_name(file))
    for t in shown:
        print("  " + describe(t))
    if not shown:
        print("  (no open comments)")


def cmd_show(args):
    file = resolve_doc(args, args.id)
    t = find_thread(read_doc(file), args.id)
    if args.json:
        return print(json.dumps(t, indent=2, ensure_ascii=False))
    print(f"{t['id']} · {rel_name(file)}:{t['line']} · {t['state']}" + (" · detached: the quote is no longer in the file" if t.get("detached") else ""))
    if t.get("page"):
        page = clean_page(t["page"])
        x, y, w, h = page["box"]
        print(f"> {describe_page(page)}\n> box {x},{y} to {x + w},{y + h} px" + (f"\n> marked up: {t['mark']}" if t.get("mark") else ""))
    elif t.get("image"):
        print(f"> image {t['image']}, {describe_region(t.get('region'))}" + (f"\n> marked up: {t['mark']}" if t.get("mark") else ""))
    else:
        for line in t["quote"].splitlines():
            print("> " + line)
    for m in t["messages"]:
        print(f"{m['who']}: {m['text']}")


def cmd_reply(args):
    file = resolve_doc(args, args.id)
    with locked(file) as doc:
        t = find_thread(doc, args.id)
        t["messages"].append({"who": "agent", "text": " ".join(args.text), "at": now()})
        t["status"] = "replied"
    print(f"replied to {args.id}")


def cmd_state(args, state):
    file = resolve_doc(args, args.id)
    set_state(file, args.id, state)
    print(f"{args.id} {state}")


def cmd_comment(args):
    file = Path(args.file).resolve()
    src = file.read_text(errors="replace")
    line, _ = current_line(src, {"quote": args.quote, "line": 1})
    tid, error = add_comment(file, args.quote, " ".join(args.text), line)
    print(f"{tid}" + (f" (not sent: {error})" if error else ""))


def main():
    ap = argparse.ArgumentParser(prog="kanna-doc", description="Prototype of `kanna doc`: comment on markdown files with the agent that opened them.")
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("open", help="show FILE with its comments beside this pane; comments go to this pane")
    s.add_argument("file")
    s.add_argument("--split", default="right", choices=["right", "down", "auto"])
    s.add_argument("--tab", action="store_true")
    s.add_argument("--print-url", action="store_true")
    for name, helptext in (("comments", "list the doc's open comments"),):
        s = sub.add_parser(name, help=helptext)
        s.add_argument("--all", action="store_true")
        s.add_argument("--doc")
        s.add_argument("--json", action="store_true")
    s = sub.add_parser("show", help="one comment and its replies")
    s.add_argument("id")
    s.add_argument("--doc")
    s.add_argument("--json", action="store_true")
    s = sub.add_parser("reply", help="answer a comment")
    s.add_argument("id")
    s.add_argument("text", nargs="+")
    s.add_argument("--doc")
    for name in ("resolve", "reopen"):
        s = sub.add_parser(name, help=f"{name} a comment")
        s.add_argument("id")
        s.add_argument("--doc")
    s = sub.add_parser("comment", help="start a comment from the command line")
    s.add_argument("file")
    s.add_argument("--quote", required=True)
    s.add_argument("text", nargs="+")
    s = sub.add_parser("serve", help=argparse.SUPPRESS)
    s.add_argument("--port", type=int, default=0)
    args = ap.parse_args()
    {"open": cmd_open, "comments": cmd_comments, "show": cmd_show, "reply": cmd_reply,
     "resolve": lambda a: cmd_state(a, "resolved"), "reopen": lambda a: cmd_state(a, "open"),
     "comment": cmd_comment, "serve": cmd_serve}[args.cmd](args)


if __name__ == "__main__":
    main()
