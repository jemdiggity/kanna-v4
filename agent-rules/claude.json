{
  "schema": 1,
  "agent": "claude",
  "version": "2026.10.10.1",
  "engine": 1,
  "versionProbe": {
    "pattern": "(\\d+\\.\\d+(?:\\.\\d+)*)"
  },
  "vocabulary": {
    "composerPrompts": [
      "❯"
    ],
    "menuCaretGlyphs": [
      "❯"
    ],
    "dividerGlyphs": [
      "─",
      "━",
      "—",
      "-"
    ],
    "waitingMarkers": [
      "do you want to allow",
      "Do you trust the files in this folder?",
      "Yes, I trust this folder",
      "Do you want to proceed?",
      "Do you want to allow this",
      "Bypass Permissions mode"
    ],
    "worktreePathMarkers": [
      ".kanna-worktrees/",
      "[⎇ "
    ],
    "spinnerGlyphs": [
      "✻",
      "✽",
      "✶",
      "✳",
      "✢",
      "✣",
      "✤",
      "✥"
    ],
    "workingFooterGlyphs": [
      "·"
    ],
    "inFlightMarkers": [
      "…"
    ],
    "doneFooterMarkers": [
      "· done "
    ],
    "subagentParentPrefixes": [
      "⏺ "
    ],
    "subagentTaskPrefixes": [
      "◯ "
    ],
    "titleBusyGlyphs": [
      "◐",
      "◑"
    ],
    "claudeStatusMarkers": [
      "manual mode",
      "shell",
      "agents",
      "for shortcuts",
      "auto mode on",
      "accept edits on",
      "plan mode on",
      "bypass permissions on",
      "⏵⏵",
      "⏸"
    ]
  },
  "rules": [
    {
      "id": "common/waiting/permission-prompt",
      "status": "needs-you",
      "priority": 200,
      "versions": "*",
      "when": {
        "anyLineWrapped": {
          "containsAny": "waitingMarkers"
        }
      }
    },
    {
      "id": "claude/busy/interrupt-marker",
      "status": "working",
      "priority": 20,
      "versions": "<2.1.263",
      "when": {
        "anyLineWrapped": {
          "contains": "esc to interrupt"
        }
      }
    },
    {
      "id": "claude/busy/working-footer",
      "status": "working",
      "priority": 30,
      "versions": "*",
      "when": {
        "anyLine": {
          "allOf": [
            {
              "anyOf": [
                {
                  "startsWithGlyphWord": "spinnerGlyphs"
                },
                {
                  "startsWithGlyphWord": "workingFooterGlyphs"
                }
              ]
            },
            {
              "containsAny": "inFlightMarkers"
            },
            {
              "not": {
                "containsAny": "doneFooterMarkers"
              }
            }
          ]
        }
      }
    },
    {
      "id": "claude/busy/active-subagent",
      "status": "working",
      "priority": 40,
      "versions": "*",
      "when": {
        "region": {
          "linesBelow": {
            "anchor": {
              "startsWithAny": "subagentParentPrefixes"
            },
            "n": 120
          }
        },
        "when": {
          "all": [
            {
              "anyLine": {
                "startsWithAny": "subagentTaskPrefixes"
              }
            },
            {
              "not": {
                "anyLine": {
                  "startsWithGlyph": "composerPrompts"
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": "claude/busy/update-installed-active",
      "status": "working",
      "priority": 42,
      "versions": "*",
      "when": {
        "all": [
          {
            "anyLine": {
              "contains": "Update installed"
            }
          },
          {
            "anyLine": {
              "allOf": [
                {
                  "anyOf": [
                    {
                      "startsWithGlyphWord": "spinnerGlyphs"
                    },
                    {
                      "startsWithGlyphWord": "workingFooterGlyphs"
                    }
                  ]
                },
                {
                  "containsAny": "inFlightMarkers"
                },
                {
                  "not": {
                    "containsAny": "doneFooterMarkers"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "claude/busy/active-task",
      "status": "working",
      "priority": 45,
      "versions": "*",
      "when": {
        "anyLineWrapped": {
          "contains": "Waiting for task"
        }
      }
    },
    {
      "id": "claude/waiting/selected-menu-option",
      "status": "needs-you",
      "priority": 200,
      "versions": "*",
      "when": {
        "anyLine": {
          "allOf": [
            {
              "startsWithGlyph": "menuCaretGlyphs"
            },
            {
              "regex": "^\\s*[^\\s]\\s+\\d+[.)]"
            }
          ]
        }
      }
    },
    {
      "id": "claude/idle/parked-composer",
      "status": "idle",
      "priority": 60,
      "versions": "*",
      "when": {
        "all": [
          {
            "anyLine": {
              "startsWithGlyph": "composerPrompts"
            }
          },
          {
            "not": {
              "anyLine": {
                "allOf": [
                  {
                    "anyOf": [
                      {
                        "startsWithGlyphWord": "spinnerGlyphs"
                      },
                      {
                        "startsWithGlyphWord": "workingFooterGlyphs"
                      }
                    ]
                  },
                  {
                    "containsAny": "inFlightMarkers"
                  },
                  {
                    "not": {
                      "containsAny": "doneFooterMarkers"
                    }
                  }
                ]
              }
            }
          },
          {
            "region": {
              "linesBelow": {
                "anchor": {
                  "startsWithGlyph": "composerPrompts"
                },
                "n": 12
              }
            },
            "when": {
              "anyLine": {
                "containsAny": "claudeStatusMarkers"
              }
            }
          },
          {
            "not": {
              "anyLineWrapped": {
                "containsAny": "waitingMarkers"
              }
            }
          },
          {
            "not": {
              "anyLine": {
                "allOf": [
                  {
                    "startsWithGlyph": "menuCaretGlyphs"
                  },
                  {
                    "regex": "^\\s*[^\\s]\\s+\\d+[.)]"
                  }
                ]
              }
            }
          },
          {
            "not": {
              "anyLineWrapped": {
                "contains": "Waiting for task"
              }
            }
          },
          {
            "not": {
              "title": {
                "startsWithGlyphWord": "titleBusyGlyphs"
              }
            }
          }
        ]
      }
    },
    {
      "id": "claude/idle/done-footer",
      "status": "idle",
      "priority": 70,
      "versions": "*",
      "when": {
        "all": [
          {
            "all": [
              {
                "any": [
                  {
                    "anyLine": {
                      "containsAny": "doneFooterMarkers"
                    }
                  },
                  {
                    "anyLineWrapped": {
                      "allOf": [
                        {
                          "startsWithGlyphWord": "spinnerGlyphs"
                        },
                        {
                          "regex": "·\\s*done(\\s|$)"
                        }
                      ]
                    }
                  }
                ]
              },
              {
                "not": {
                  "anyLine": {
                    "allOf": [
                      {
                        "anyOf": [
                          {
                            "startsWithGlyphWord": "spinnerGlyphs"
                          },
                          {
                            "startsWithGlyphWord": "workingFooterGlyphs"
                          }
                        ]
                      },
                      {
                        "containsAny": "inFlightMarkers"
                      },
                      {
                        "not": {
                          "containsAny": "doneFooterMarkers"
                        }
                      }
                    ]
                  }
                }
              }
            ]
          },
          {
            "not": {
              "anyLine": {
                "allOf": [
                  {
                    "anyOf": [
                      {
                        "startsWithGlyphWord": "spinnerGlyphs"
                      },
                      {
                        "startsWithGlyphWord": "workingFooterGlyphs"
                      }
                    ]
                  },
                  {
                    "containsAny": "inFlightMarkers"
                  },
                  {
                    "not": {
                      "containsAny": "doneFooterMarkers"
                    }
                  }
                ]
              }
            }
          },
          {
            "not": {
              "anyLineWrapped": {
                "containsAny": "waitingMarkers"
              }
            }
          },
          {
            "not": {
              "anyLine": {
                "allOf": [
                  {
                    "startsWithGlyph": "menuCaretGlyphs"
                  },
                  {
                    "regex": "^\\s*[^\\s]\\s+\\d+[.)]"
                  }
                ]
              }
            }
          },
          {
            "not": {
              "anyLineWrapped": {
                "contains": "Waiting for task"
              }
            }
          },
          {
            "not": {
              "title": {
                "startsWithGlyphWord": "titleBusyGlyphs"
              }
            }
          }
        ]
      }
    },
    {
      "id": "claude/busy/title-spinner",
      "status": "working",
      "priority": 10,
      "versions": ">=2.1.263",
      "when": {
        "title": {
          "startsWithGlyphWord": "titleBusyGlyphs"
        }
      }
    }
  ]
}
