{
  "schema": 1,
  "agent": "codex",
  "version": "2026.10.10.1",
  "engine": 1,
  "programs": [
    "codex"
  ],
  "versionProbe": {
    "args": [
      "--version"
    ],
    "pattern": "(\\d+\\.\\d+(?:\\.\\d+)*)"
  },
  "vocabulary": {
    "composerPrompts": [
      "›"
    ],
    "menuCaretGlyphs": [
      "❯"
    ],
    "dividerGlyphs": [
      "─",
      "━",
      "—",
      "-"
    ],
    "waitingMarkers": [
      "do you want to allow",
      "Trust this folder?",
      "Trust and continue",
      "Do you want to run this command?",
      "Would you like to run the following command?",
      "Would you like to make the following edits?",
      "Do you trust the contents of this directory?"
    ],
    "worktreePathMarkers": [
      ".kanna-worktrees/",
      "[⎇ "
    ],
    "idlePromptGlyphs": [
      "›"
    ],
    "busyMarkers": [
      "Working (",
      "esc to interrupt",
      "Waiting for background terminal",
      "background terminal running"
    ],
    "claudeStatusMarkers": [
      "manual mode",
      "shell",
      "agents",
      "for shortcuts"
    ],
    "composerPlaceholders": [
      "Ask Codex to do anything",
      "Write tests for @filename",
      "Find and fix a bug in @filename",
      "Explain this codebase",
      "Implement {feature}",
      "Summarize recent commits",
      "Use /skills to list available skills",
      "Improve documentation in @filename"
    ],
    "composerFooterMarkers": [
      "for shortcuts",
      "context left",
      "default ·",
      "low ·",
      "medium ·",
      "high ·",
      "xhigh ·",
      "for agents"
    ]
  },
  "rules": [
    {
      "id": "common/waiting/permission-prompt",
      "status": "needs-you",
      "priority": 200,
      "versions": "*",
      "when": {
        "anyLineWrapped": {
          "containsAny": "waitingMarkers"
        }
      }
    },
    {
      "id": "codex/waiting/selected-menu-option",
      "status": "needs-you",
      "priority": 200,
      "versions": "*",
      "when": {
        "anyLine": {
          "regex": "^\\s*›\\s+\\d+[.)]"
        }
      }
    },
    {
      "id": "codex/busy/working-background-terminal",
      "status": "working",
      "priority": 12,
      "versions": "*",
      "when": {
        "anyLineWrapped": {
          "allOf": [
            {
              "contains": "Working ("
            },
            {
              "contains": "background terminal running"
            },
            {
              "contains": "esc to interrupt"
            }
          ]
        }
      }
    },
    {
      "id": "codex/busy/background-terminal",
      "status": "working",
      "priority": 14,
      "versions": "*",
      "when": {
        "anyLineWrapped": {
          "contains": "Waiting for background terminal"
        }
      }
    },
    {
      "id": "codex/busy/interrupt-marker",
      "status": "working",
      "priority": 20,
      "versions": "*",
      "when": {
        "anyLineWrapped": {
          "contains": "esc to interrupt"
        }
      }
    },
    {
      "id": "codex/idle/composer",
      "status": "idle",
      "priority": 60,
      "versions": "*",
      "when": {
        "all": [
          {
            "anyLine": {
              "startsWithGlyph": "idlePromptGlyphs"
            }
          },
          {
            "not": {
              "anyLineWrapped": {
                "containsAny": "busyMarkers"
              }
            }
          }
        ]
      }
    }
  ]
}
