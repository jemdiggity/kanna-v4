{
  "schema": 1,
  "agent": "copilot",
  "version": "2026.10.10.1",
  "engine": 1,
  "programs": [
    "copilot"
  ],
  "versionProbe": {
    "args": [
      "--version"
    ],
    "pattern": "(\\d+\\.\\d+(?:\\.\\d+)*)"
  },
  "vocabulary": {
    "composerPrompts": [
      "❯",
      "›"
    ],
    "menuCaretGlyphs": [
      "❯"
    ],
    "dividerGlyphs": [
      "─",
      "━",
      "—",
      "-"
    ],
    "waitingMarkers": [
      "do you want to allow"
    ],
    "worktreePathMarkers": [
      ".kanna-worktrees/",
      "[⎇ "
    ],
    "idlePromptGlyphs": [
      "❯"
    ],
    "busyMarkers": [
      "esc to cancel",
      "thinking "
    ],
    "claudeStatusMarkers": [
      "manual mode",
      "shell",
      "agents",
      "for shortcuts"
    ]
  },
  "rules": [
    {
      "id": "common/waiting/permission-prompt",
      "status": "needs-you",
      "priority": 10,
      "versions": "*",
      "when": {
        "anyLineWrapped": {
          "containsAny": "waitingMarkers"
        }
      }
    },
    {
      "id": "copilot/busy/above-path",
      "status": "working",
      "priority": 30,
      "versions": "*",
      "when": {
        "region": {
          "linesAbove": {
            "anchor": {
              "containsAny": "worktreePathMarkers"
            },
            "n": 1
          }
        },
        "when": {
          "anyLine": {
            "containsAny": "busyMarkers"
          }
        }
      }
    },
    {
      "id": "copilot/idle/below-path",
      "status": "idle",
      "priority": 35,
      "versions": "*",
      "when": {
        "region": {
          "linesBelow": {
            "anchor": {
              "containsAny": "worktreePathMarkers"
            },
            "n": 120
          }
        },
        "when": {
          "anyLine": {
            "glyphOnly": "idlePromptGlyphs"
          }
        }
      }
    },
    {
      "id": "copilot/busy/cancel-marker",
      "status": "working",
      "priority": 40,
      "versions": "*",
      "when": {
        "anyLineWrapped": {
          "contains": "esc to cancel"
        }
      }
    },
    {
      "id": "copilot/idle/last-line-composer",
      "status": "idle",
      "priority": 60,
      "versions": "*",
      "when": {
        "lastNonEmptyLine": {
          "startsWithGlyph": "idlePromptGlyphs"
        }
      }
    }
  ]
}
