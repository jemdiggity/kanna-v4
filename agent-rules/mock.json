{
  "schema": 1,
  "agent": "mock",
  "version": "2026.10.10.1",
  "engine": 1,
  "vocabulary": {
    "composerPrompts": [
      "›"
    ]
  },
  "rules": [
    {
      "id": "mock/needs-you/proceed",
      "status": "needs-you",
      "priority": 200,
      "when": {
        "anyLine": {
          "contains": "Do you want to proceed?"
        }
      }
    },
    {
      "id": "mock/working/interrupt",
      "status": "working",
      "priority": 100,
      "when": {
        "anyLineWrapped": {
          "contains": "esc to interrupt"
        }
      }
    },
    {
      "id": "mock/working/progress",
      "status": "working",
      "priority": 90,
      "when": {
        "progress": {
          "anyOf": [
            {
              "equals": "indeterminate"
            },
            {
              "equals": "set"
            }
          ]
        }
      }
    },
    {
      "id": "mock/idle/composer",
      "status": "idle",
      "priority": 50,
      "when": {
        "anyLine": {
          "startsWithGlyph": "composerPrompts"
        }
      }
    }
  ]
}
