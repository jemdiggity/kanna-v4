{
  "schema": 1,
  "agent": "opencode",
  "version": "2026.10.10.1",
  "engine": 1,
  "versionProbe": {
    "pattern": "(\\d+\\.\\d+(?:\\.\\d+)*)"
  },
  "vocabulary": {
    "composerPrompts": [
      "❯",
      "›"
    ],
    "menuCaretGlyphs": [
      "❯"
    ],
    "dividerGlyphs": [
      "─",
      "━",
      "—",
      "-"
    ],
    "waitingMarkers": [
      "do you want to allow"
    ],
    "worktreePathMarkers": [
      ".kanna-worktrees/",
      "[⎇ "
    ],
    "boxBorderGlyphs": [
      "┃"
    ],
    "blockArtGlyphs": [
      "╹",
      "▀",
      "▄",
      "█",
      "▌",
      "▐"
    ],
    "inFlightMarkers": [
      "escape interrupt",
      "esc interrupt",
      "esc to interrupt"
    ],
    "permissionActionMarkers": [
      "allow once",
      "allow always"
    ],
    "turnSummaryGlyphs": [
      "▣"
    ],
    "footerProgressGlyphs": [
      "⬝",
      "■"
    ],
    "composerStatusSeparators": [
      " · "
    ],
    "claudeStatusMarkers": [
      "manual mode",
      "shell",
      "agents",
      "for shortcuts"
    ]
  },
  "rules": [
    {
      "id": "common/waiting/permission-prompt",
      "status": "needs-you",
      "priority": 10,
      "versions": "*",
      "when": {
        "anyLineWrapped": {
          "containsAny": "waitingMarkers"
        }
      }
    },
    {
      "id": "opencode/waiting/permission-action",
      "status": "needs-you",
      "priority": 15,
      "versions": "*",
      "when": {
        "anyLine": {
          "containsAllOf": "permissionActionMarkers"
        }
      }
    },
    {
      "id": "opencode/busy/interrupt-marker",
      "status": "working",
      "priority": 20,
      "versions": "*",
      "when": {
        "anyLine": {
          "containsAny": "inFlightMarkers"
        }
      }
    },
    {
      "id": "opencode/idle/composer-status",
      "status": "idle",
      "priority": 60,
      "versions": "*",
      "when": {
        "all": [
          {
            "anyLine": {
              "allOf": [
                {
                  "startsWithGlyph": "boxBorderGlyphs"
                },
                {
                  "containsAny": "composerStatusSeparators"
                }
              ]
            }
          },
          {
            "not": {
              "anyLine": {
                "containsAny": "inFlightMarkers"
              }
            }
          }
        ]
      }
    }
  ]
}
