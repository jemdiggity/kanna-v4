{
  "schema": 1,
  "agent": "antigravity",
  "version": "2026.10.10.1",
  "engine": 1,
  "programs": [
    "agy",
    "antigravity"
  ],
  "versionProbe": {
    "args": [
      "--version"
    ],
    "pattern": "(\\d+\\.\\d+(?:\\.\\d+)*)"
  },
  "vocabulary": {
    "composerPrompts": [
      "❯",
      "›"
    ],
    "menuCaretGlyphs": [
      "❯"
    ],
    "dividerGlyphs": [
      "─",
      "━",
      "—",
      "-"
    ],
    "waitingMarkers": [
      "do you want to allow"
    ],
    "worktreePathMarkers": [
      ".kanna-worktrees/",
      "[⎇ "
    ],
    "idlePromptGlyphs": [
      "›"
    ],
    "busyMarkers": [
      "esc to cancel"
    ],
    "claudeStatusMarkers": [
      "manual mode",
      "shell",
      "agents",
      "for shortcuts"
    ]
  },
  "rules": [
    {
      "id": "common/waiting/permission-prompt",
      "status": "needs-you",
      "priority": 10,
      "versions": "*",
      "when": {
        "anyLineWrapped": {
          "containsAny": "waitingMarkers"
        }
      }
    },
    {
      "id": "antigravity/busy/cancel-marker",
      "status": "working",
      "priority": 20,
      "versions": "*",
      "when": {
        "anyLineWrapped": {
          "containsAny": "busyMarkers"
        }
      }
    },
    {
      "id": "antigravity/idle/composer",
      "status": "idle",
      "priority": 60,
      "versions": "*",
      "when": {
        "lastNonEmptyLine": {
          "startsWithGlyph": "idlePromptGlyphs"
        }
      }
    }
  ]
}
